101 RCDATA "build/PuppetPin.ofx.bundle/Contents/Win64/PuppetPin.ofx"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,5,0,0
PRODUCTVERSION 1,5,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
