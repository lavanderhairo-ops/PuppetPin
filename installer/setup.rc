    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Puppet Pin"
            VALUE "FileDescription", "Puppet Pin Setup (OFX plugin for DaVinci Resolve)"
            VALUE "FileVersion", "1.5.0.0"
            VALUE "ProductName", "Puppet Pin"
            VALUE "ProductVersion", "1.5"
            VALUE "OriginalFilename", "PuppetPin-1.5-Setup.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
